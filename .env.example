# RoleSharp Environment Configuration Template

# Database & Cache
DATABASE_URL=postgres://rolesharp:password@127.0.0.1:5432/rolesharp
REDIS_URL=redis://127.0.0.1:6379

# Site
SITE_URL=http://localhost:3000

# Authentication & Security
AUTH_SECRET=
ADMIN_TOTP_SECRET=

# Staff Authentication
STAFF_GOOGLE_CLIENT_ID=
STAFF_GOOGLE_CLIENT_SECRET=
# STAFF_OWNER_EMAIL: only account that may bootstrap the first active owner
STAFF_OWNER_EMAIL=

# Workflows & Integrations (disabled by default)
JOBS_WORKFLOWS_ENABLED=false
ROLE_APPLY_GMAIL_SEND_ENABLED=false
ROLE_APPLY_MICROSOFT_SEND_ENABLED=false
